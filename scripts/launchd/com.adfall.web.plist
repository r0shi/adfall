<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Adfall static site: app/serve.mjs on 0.0.0.0:4173, reading app/build live so a rebuild never needs a restart.
       Pair it with tailscale serve for HTTPS on the tailnet. See README.md, "The app". -->
  <key>Label</key><string>com.adfall.web</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/opt/node@22/bin/node</string>
    <string>/Users/alex/tv_wormhole/app/serve.mjs</string>
    <string>--host</string><string>0.0.0.0</string>
    <string>--port</string><string>4173</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/alex/tv_wormhole/app</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/opt/node@22/bin:/opt/homebrew/bin:/Users/alex/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key><string>/Users/alex/tv_wormhole/data/logs/launchd-web.log</string>
  <key>StandardErrorPath</key><string>/Users/alex/tv_wormhole/data/logs/launchd-web.log</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
