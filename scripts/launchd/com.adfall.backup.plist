<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Nightly Postgres backup (scripts/backup.sh) at 03:30 local time.
  Install / remove:     scripts/launchd/agents.sh install backup | uninstall backup
  To run it now:        scripts/launchd/agents.sh run backup
  Output goes to data/logs/backup.log. A missed run (Mac asleep) fires on the next wake.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.adfall.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/Users/alex/tv_wormhole/scripts/backup.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/alex/tv_wormhole</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/opt/postgresql@17/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/alex</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/alex/tv_wormhole/data/logs/backup.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/alex/tv_wormhole/data/logs/backup.log</string>
  <key>Nice</key>
  <integer>10</integer>
</dict>
</plist>
