# copy to .env; ingest reads DATABASE_URL (defaults to the compose service below)
DATABASE_URL=postgresql://tvw:tvw@127.0.0.1:5434/tvw
# scripts/backup.sh: Backblaze B2 bucket for the nightly pg_dump (needs rclone or the b2 CLI configured; see the script)
#B2_BUCKET=
#B2_PREFIX=adfall/postgres

# scripts/publish.sh (run by scripts/daily.sh after a clean export once R2_BUCKET is set): data to R2, app to Pages.
# R2: a bucket with a custom domain (DATA_URL) and a CORS rule allowing GET/HEAD with the Range header from the site;
# an R2 API token with object read & write gives the access key pair. Pages: a direct-upload project named
# PAGES_PROJECT and an account API token with Pages edit. SITE_URL is the Origin the CORS check sends.
#R2_BUCKET=adfall-data
#R2_ACCOUNT_ID=
#R2_ACCESS_KEY_ID=
#R2_SECRET_ACCESS_KEY=
#DATA_URL=https://data.adfall.example
#CLOUDFLARE_API_TOKEN=
#CLOUDFLARE_ACCOUNT_ID=
#PAGES_PROJECT=adfall
#SITE_URL=https://adfall.pages.dev
#PUBLISH_KEEP=3
#PUBLISH_PING=
